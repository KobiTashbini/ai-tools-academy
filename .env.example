# Copy to .env.local (never committed) and fill in. See database/README.md.
# Supabase -> Connect -> Direct -> Session pooler (URI). Replace [YOUR-PASSWORD], brackets included.
# Percent-encode special characters in the password: @ -> %40, # -> %23, $ -> %24, % -> %25.
# Local development uses the project owner; before deployment switch the user to
# academy_build_reader.winnpnsmwkullbhrolan (migration 005, task T-024).
DATABASE_URL=postgresql://postgres.winnpnsmwkullbhrolan:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Optional: path to the Supabase CA certificate to verify the server certificate.
# DATABASE_SSL_CA=certs/supabase-ca.crt
