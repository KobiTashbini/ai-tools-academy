  "scope": [
    {
      "entry": {
        "id": "dify",
        "kind": "platform",
        "name": "Dify",
        "slug": "dify",
        "addedAt": "2026-10-31",
        "example": "תרחיש לימודי: אבטיפוס לשאלות על נוהל קליטת עובד. המערכת מחזירה תשובה עם מקור ומפנה לאדם כאשר המידע אינו מספיק.",
        "sources": [
          {
            "url": "https://docs.dify.ai/en/home",
            "title": "Dify — Documentation",
            "supports": "יישומי AI, סוכנים, ידע, תהליכים ופרסום דרך Web/API. תכנון האבטיפוס והשיקולים הם שלנו.",
            "checkedAt": "2026-10-31"
          }
        ],
        "summary": "פלטפורמה לבניית יישומי AI, תהליכים וצ'אטבוטים עם חיבור לנתונים ולממשקי API.",
        "exercise": "צייר ארבעה שלבים לצ'אטבוט נוהלים. תוצר: חוזה לכל מעבר, מקרה ללא מקור ושתי בדיקות למידע שאסור לחשוף. הסבר מה יישאר בקוד הארגוני.",
        "revision": 2,
        "sections": [
          {
            "text": "Dify מציעה סביבת בנייה ליישומי AI, סוכנים ותהליכים. התיעוד מציג חיבור לידע ופרסום כיישום Web או אינטגרציה דרך API. זהו מוצר סביב היישום, ולא מודל בפני עצמו.",
            "title": "מה היא פותרת?"
          },
          {
            "text": "המלצה: הפרד קלט משתמש, שליפת ידע, קריאת מודל ועיבוד פלט. הגדר במפורש נתונים שעוברים בין השלבים, ומצב שבו אין מקור או שהמודל מחזיר תשובה לא תקינה.",
            "title": "איך מתכננים זרימה?"
          },
          {
            "text": "אפשר לחשוב על הפלטפורמה כשכבת יישום שניתן לחבר למסך דרך API. עדיין צריך לתכנן אימות משתמשים, שמירת מצב והגבול שבין הדפדפן לשרת.",
            "title": "החיבור ל־React ו־REST"
          },
          {
            "text": "המלצה: אבטיפוס ושיתוף תהליך AI עם אנשים שרוצים להבין אותו חזותית. כשיש כללים עסקיים מורכבים, שקול לחשוף שירות קטן שמממש אותם בקוד בדוק.",
            "title": "מתי לבחור?"
          },
          {
            "text": "בדוק הרשאות לידע, ספקי מודלים ומסלול האירוח. בהשוואה כלול גם עלות מודל ותחזוקת הפלטפורמה. אל תחשוף מפתח שרת של היישום בקוד React.",
            "title": "אבטחה ועלות"
          }
        ],
        "verifiedAt": "2026-10-31",
        "categoryIds": [
          "06"
        ],
        "addedAtBasis": "historical_backfill",
        "relatedSlugs": [
          "n8n",
          "llamaindex",
          "mcp"
        ],
        "revisionNote": "פרק לימוד. האימות מתייחס להגדרת המוצר וליכולות המתוארות במקורות; מחירים, גרסאות חבילות וביצועים לא נבדקו. שיקולי התכנון והתרגילים הם תוכן לימודי שלנו.",
        "prerequisites": "מודל שפה, HTTP והגדרת תהליך.",
        "alternativesNote": "Flowise ו־Langflow הם מועמדים ממפת הידע להשוואה. חלופה בקוד יכולה להיות React עם שירות AI ממוקד, כשנדרשת שליטה גבוהה יותר.",
        "learningPriority": "should_know",
        "publicationStatus": "published",
        "verificationStatus": "verified",
        "languageSupportNote": "בנייה חזותית אינה SDK ל־C#, Python או TypeScript. שילוב API יכול לשרת כל לקוח HTTP; שוויון יכולות בין מסלולי אירוח לא נבדק כאן."
      },
