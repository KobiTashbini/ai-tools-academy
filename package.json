    "metrics:refresh": "node scripts/collect-inference-metrics.mjs",
    "research:check": "node scripts/check-research.mjs",
    "database:prepare": "node scripts/prepare-database.mjs",
    "catalog:check": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~5.9.3"
  }
}
